# Production URL, used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.quantexai.solutions

# Powers the site chat assistant. Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# CHAT_RATE_LIMIT_PER_HOUR=20

# Shared store for request limits (chat and site check). Without it, each
# server instance counts on its own and the limits do not hold on Vercel.
# Add the Upstash Redis integration from the Vercel Marketplace and these are
# set for you (KV_REST_API_URL / KV_REST_API_TOKEN are accepted too).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional ceiling on chat messages from all visitors per day. Caps what the
# assistant can cost in a day. Needs the shared store above to hold.
# CHAT_DAILY_LIMIT=500
